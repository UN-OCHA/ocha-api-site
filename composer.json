{
    "name": "unocha/ocha-api",
    "description": "OCHA API Server",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.3",
        "api-platform/symfony": "^3 || ^4",
        "cweagans/composer-patches": "^2.0",
        "doctrine/doctrine-bundle": "^3",
        "doctrine/doctrine-migrations-bundle": "^4",
        "doctrine/orm": "^3",
        "nelmio/cors-bundle": "^2",
        "netbrothers-gmbh/version-bundle": "^4",
        "phpdocumentor/reflection-docblock": "^6",
        "phpstan/phpdoc-parser": "^2",
        "scienta/doctrine-json-functions": "^6",
        "symfony/amazon-mailer": "^8",
        "symfony/apache-pack": "^1",
        "symfony/asset": "^8",
        "symfony/console": "^8",
        "symfony/doctrine-messenger": "^8",
        "symfony/dotenv": "^8",
        "symfony/expression-language": "^8",
        "symfony/flex": "^2",
        "symfony/form": "^8",
        "symfony/framework-bundle": "^8",
        "symfony/http-client": "^8",
        "symfony/intl": "^8",
        "symfony/mailer": "^8",
        "symfony/mime": "^8",
        "symfony/monolog-bundle": "^4",
        "symfony/notifier": "^8",
        "symfony/process": "^8",
        "symfony/property-access": "^8",
        "symfony/property-info": "^8",
        "symfony/proxy-manager-bridge": "^6",
        "symfony/runtime": "^8",
        "symfony/security-bundle": "^8",
        "symfony/serializer": "^8",
        "symfony/string": "^8",
        "symfony/translation": "^8",
        "symfony/twig-bundle": "^8",
        "symfony/validator": "^8",
        "symfony/web-link": "^8",
        "symfony/yaml": "^8",
        "twig/extra-bundle": "^3",
        "twig/twig": "^3"
    },
    "config": {
       "policy": {
            "advisories": {
                "audit": "fail",
                "ignore-severity": {
                    "low":    { "on-audit": true, "reason": "Do not alert on low severity issues." },
                    "medium": { "on-audit": true, "reason": "Do not alert on medium severity issues." }
                },
                "ignore-id": {
                }
            },
            "abandoned": {
                "audit": "report"
            },
            "malware:": {
                "block-scope": "all"
            }
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "cweagans/composer-patches": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "changelog": "conventional-changelog",
        "release": "conventional-changelog",
        "release:patch": "conventional-changelog --patch",
        "release:minor": "conventional-changelog --minor",
        "release:major": "conventional-changelog --major"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "*"
        }
    },
    "require-dev": {
        "hautelook/alice-bundle": "^2.11",
        "justinrainbow/json-schema": "^5.2",
        "marcocesarato/php-conventional-changelog": "^1.16",
        "phpunit/php-code-coverage": "^9.2",
        "phpunit/phpunit": "^9.5",
        "symfony/browser-kit": "*",
        "symfony/css-selector": "*",
        "symfony/debug-bundle": "*",
        "symfony/maker-bundle": "^1.47",
        "symfony/phpunit-bridge": "*",
        "symfony/stopwatch": "*",
        "symfony/web-profiler-bundle": "*"
    },
    "version": "1.2.0"
}
