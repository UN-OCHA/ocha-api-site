{
    "name": "unocha/ocha-api",
    "description": "OCHA API Server",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.3",
        "api-platform/symfony": "^3 || ^4",
        "doctrine/doctrine-bundle": "*",
        "doctrine/doctrine-migrations-bundle": "*",
        "doctrine/orm": "*",
        "nelmio/cors-bundle": "*",
        "netbrothers-gmbh/version-bundle": "*",
        "phpdocumentor/reflection-docblock": "*",
        "phpstan/phpdoc-parser": "*",
        "scienta/doctrine-json-functions": "*",
        "symfony/amazon-mailer": "*",
        "symfony/apache-pack": "*",
        "symfony/asset": "*",
        "symfony/console": "*",
        "symfony/doctrine-messenger": "*",
        "symfony/dotenv": "*",
        "symfony/expression-language": "*",
        "symfony/flex": "*",
        "symfony/form": "*",
        "symfony/framework-bundle": "*",
        "symfony/http-client": "*",
        "symfony/intl": "*",
        "symfony/mailer": "*",
        "symfony/mime": "*",
        "symfony/monolog-bundle": "*",
        "symfony/notifier": "*",
        "symfony/process": "*",
        "symfony/property-access": "*",
        "symfony/property-info": "*",
        "symfony/proxy-manager-bridge": "*",
        "symfony/runtime": "*",
        "symfony/security-bundle": "*",
        "symfony/serializer": "*",
        "symfony/string": "*",
        "symfony/translation": "*",
        "symfony/twig-bundle": "*",
        "symfony/validator": "*",
        "symfony/web-link": "*",
        "symfony/yaml": "*",
        "twig/extra-bundle": "*",
        "twig/twig": "*"
    },
    "config": {
       "policy": {
            "advisories": {
                "audit": "fail",
                "ignore-severity": {
                    "low":    { "on-audit": true, "reason": "Do not alert on low severity issues." },
                    "medium": { "on-audit": true, "reason": "Do not alert on medium severity issues." }
                },
                "ignore-id": {
                    "PKSA-8kfs-m8zw-ggzs": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-3ncz-km6v-5vjr": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-gs8r-6kz6-pp56": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-gnn4-pxdg-q76m": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-q2bp-c9gn-wy37": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-jms4-fggn-5mmn": "OHA-71 - Allow builds to compelete for *other* updates.",
                    "PKSA-dsd6-6541-26zs": "OHA-71 - Allow builds to compelete for *other* updates."
                }
            },
            "abandoned": {
                "audit": "report"
            },
            "malware:": {
                "block-scope": "all"
            }
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "changelog": "conventional-changelog",
        "release": "conventional-changelog",
        "release:patch": "conventional-changelog --patch",
        "release:minor": "conventional-changelog --minor",
        "release:major": "conventional-changelog --major"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "*"
        }
    },
    "require-dev": {
        "hautelook/alice-bundle": "^2.11",
        "justinrainbow/json-schema": "^5.2",
        "marcocesarato/php-conventional-changelog": "^1.16",
        "phpunit/php-code-coverage": "^9.2",
        "phpunit/phpunit": "^9.5",
        "symfony/browser-kit": "*",
        "symfony/css-selector": "*",
        "symfony/debug-bundle": "*",
        "symfony/maker-bundle": "^1.47",
        "symfony/phpunit-bridge": "*",
        "symfony/stopwatch": "*",
        "symfony/web-profiler-bundle": "*"
    },
    "version": "1.2.0"
}
